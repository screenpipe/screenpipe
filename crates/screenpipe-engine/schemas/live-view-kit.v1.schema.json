{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-view-kit.v1",
  "title": "screenpipe Live View Kit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "description",
    "version",
    "pipes",
    "template"
  ],
  "properties": {
    "schema": {
      "const": "live-view-kit.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pipes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "distribution"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "distribution": {
            "const": "bundled"
          }
        }
      }
    },
    "template": {
      "$ref": "live-view-template.v1.schema.json"
    }
  }
}
