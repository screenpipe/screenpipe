+// screenpipe — AI that knows everything you've seen, said, or heard
+// https://screenpipe.com
+// screenpipe-thinking-binding-v1
+// Screenpipe compacts and prunes history. Native Anthropic thinking signatures
+// are prefix-bound: let the API discard invalid reasoning, preserving chat/tool
+// content and valid reasoning. Keep compatible third-party endpoints unchanged.
+const screenpipeThinkingBindingBeta = "thinking-binding-controls-2026-08-01";
+function screenpipeUsesThinkingBinding(model) {
+    return new URL(model.baseUrl).hostname === "api.anthropic.com";
+}
+function screenpipeThinkingBindingHeaders(headers, model) {
+    if (!screenpipeUsesThinkingBinding(model)) return headers;
+    const merged = new Headers(headers);
+    const betas = new Set((merged.get("anthropic-beta") ?? "").split(",").map(value => value.trim()).filter(Boolean));
+    betas.add(screenpipeThinkingBindingBeta);
+    merged.set("anthropic-beta", [...betas].join(","));
+    return Object.fromEntries(merged);
+}
+function screenpipeReportThinkingDrops(transformations, requestId) {
+    for (const entry of transformations ?? []) {
+        if (entry.type !== "thinking_dropped" || ![
+            "prefix_binding_mismatch", "model_binding_mismatch", "organization_binding_mismatch", "end_user_binding_mismatch",
+        ].includes(entry.reason) || !/^messages\.\d+\.content\.\d+$/.test(entry.path)) continue;
+        // Stderr reaches ordinary app logs and the redacted support bundle.
+        // Never include thinking, signatures, user text, or tool payloads.
+        console.warn(`[screenpipe-thinking-binding] outcome=request_accepted_without_block reason=${entry.reason} path=${entry.path} request_id=${requestId ?? "unknown"}`);
+    }
+}
