-- screenpipe onboarding H1 follow-up v1
-- Cohort: identified external users whose H1 follow-up was scheduled at least
-- 24 hours ago. Every later signal is bounded to the next 24 hours. A 2xx from
-- /notify means accepted by the local service; only notification_shown proves
-- display. The latest submitted up/down rating wins.

WITH scheduled AS (
  SELECT
    person_id,
    min(timestamp) AS scheduled_at
  FROM events
  WHERE event = 'onboarding_h1_follow_up'
    AND toString(properties.metric_version) = 'onboarding_h1_follow_up_v1'
    AND toString(properties.stage) = 'scheduled'
    AND timestamp >= addDays(now(), -60)
    AND person.properties.email IS NOT NULL
    AND person.properties.email != ''
    AND person.properties.email NOT LIKE '%@screenpipe.test'
    AND person.properties.email NOT LIKE '%@screenpipe.com'
    AND person.properties.email NOT LIKE '%@screenpi.pe'
  GROUP BY person_id
),
eligible AS (
  SELECT person_id, scheduled_at
  FROM scheduled
  WHERE scheduled_at < addHours(now(), -24)
),
per_person AS (
  SELECT
    e.person_id,
    s.scheduled_at,
    windowFunnel(86400)(
      e.timestamp,
      e.event = 'onboarding_h1_follow_up'
        AND toString(e.properties.metric_version) = 'onboarding_h1_follow_up_v1'
        AND toString(e.properties.stage) = 'scheduled',
      e.event = 'onboarding_h1_follow_up'
        AND toString(e.properties.metric_version) = 'onboarding_h1_follow_up_v1'
        AND toString(e.properties.stage) = 'delivery_attempted',
      e.event = 'onboarding_h1_follow_up'
        AND toString(e.properties.metric_version) = 'onboarding_h1_follow_up_v1'
        AND toString(e.properties.stage) = 'notification_accepted',
      e.event = 'notification_shown'
        AND toString(e.properties.analytics_schema_version) = 'notification_v2'
        AND toString(e.properties.notification_category) = 'onboarding_h1_follow_up',
      e.event IN ('notification_action', 'notification_bell_action')
        AND toString(e.properties.analytics_schema_version) = 'notification_v2'
        AND toString(e.properties.notification_category) = 'onboarding_h1_follow_up'
    ) AS funnel_level,
    argMaxIf(
      toString(e.properties.feedback_rating),
      e.timestamp,
      e.event = 'notification_feedback_submitted'
        AND toString(e.properties.analytics_schema_version) = 'notification_v2'
        AND toString(e.properties.notification_category) = 'onboarding_h1_follow_up'
        AND toString(e.properties.feedback_rating) IN ('up', 'down')
    ) AS latest_feedback_rating
  FROM events e
  INNER JOIN eligible s ON e.person_id = s.person_id
  WHERE e.timestamp >= s.scheduled_at
    AND e.timestamp < addHours(s.scheduled_at, 24)
    AND (
      (
        e.event = 'onboarding_h1_follow_up'
        AND toString(e.properties.metric_version) = 'onboarding_h1_follow_up_v1'
      )
      OR (
        e.event IN (
          'notification_shown',
          'notification_action',
          'notification_bell_action',
          'notification_feedback_submitted'
        )
        AND toString(e.properties.analytics_schema_version) = 'notification_v2'
        AND toString(e.properties.notification_category) = 'onboarding_h1_follow_up'
      )
    )
  GROUP BY e.person_id, s.scheduled_at
),
cohorts AS (
  SELECT
    person_id,
    funnel_level,
    latest_feedback_rating,
    toStartOfWeek(
      toDate(toTimeZone(scheduled_at, 'America/Los_Angeles')),
      1
    ) AS cohort_week
  FROM per_person
),
latest_weeks AS (
  SELECT cohort_week
  FROM cohorts
  GROUP BY cohort_week
  ORDER BY cohort_week DESC
  LIMIT 2
)
SELECT
  cohort_week,
  arrayJoin(range(1, 6)) AS step_index,
  multiIf(
    step_index = 1, 'H1 follow-up scheduled',
    step_index = 2, 'H1 refresh attempted',
    step_index = 3, 'H1 notification accepted by local service',
    step_index = 4, 'H1 notification shown',
    'H1 notification opened'
  ) AS ui_step,
  countIf(funnel_level >= step_index) AS users,
  count() AS scheduled_users,
  round(100.0 * users / nullIf(scheduled_users, 0), 1)
    AS conversion_from_scheduled_pct,
  countIf(latest_feedback_rating = 'up') AS useful_users,
  countIf(latest_feedback_rating = 'down') AS not_useful_users,
  useful_users + not_useful_users AS rated_users,
  round(100.0 * useful_users / nullIf(rated_users, 0), 1)
    AS useful_pct_among_rated
FROM cohorts
WHERE cohort_week IN (SELECT cohort_week FROM latest_weeks)
GROUP BY cohort_week, step_index
ORDER BY cohort_week, step_index
